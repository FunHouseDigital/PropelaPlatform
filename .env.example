# Public Vite build configuration
# Vite reads VITE_ variables only while building the static bundle. Docker
# Compose passes these values from .env through build.args; the final nginx
# container does not read .env at runtime. Rebuild/redeploy after any change.
# Every VITE_ value is browser-visible and must be safe to expose.

# Application Settings
VITE_APP_TITLE=Propela Platform
VITE_APP_VERSION=1.0.0

# API Configuration
VITE_API_URL=http://localhost:3001/api

# Error Tracking
VITE_SENTRY_DSN=

# Progressive Web App
VITE_ENABLE_SERVICE_WORKER=true

# Analytics
VITE_ENABLE_ANALYTICS=false

# Environment (development | staging | production)
VITE_ENVIRONMENT=development

# Logging Level (debug | info | warn | error)
VITE_LOG_LEVEL=debug

# Feature Flags (comma-separated list of enabled flags)
# Available flags: ENHANCED_ANALYTICS, WORKFLOW_AUTOMATION_V2, DARK_MODE, AI_SUGGESTIONS, SUPABASE_BACKEND
# SUPABASE_BACKEND defaults OFF (legacy localStorage path). Enable it to route the Data_Layer to Supabase.
VITE_FEATURE_FLAGS=

# Supabase (Online Platform)
# PUBLIC build-time frontend values. The anon key is safe to expose only because
# database access is constrained by RLS. Apply migrations through 0008 and set
# these values before enabling SUPABASE_BACKEND and building for production.
# Leave blank here; fill real public values in an untracked local .env or the
# production hosting provider's build environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SECURITY: NEVER place the Supabase service_role key or the database password in
# frontend env or in this .env.example. Those secrets bypass RLS and must live
# ONLY in secure server-side/CI/migration environments (e.g. CI secrets), never
# in version control or anything shipped to the client.
