{
  "name": "propela-ops",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:vercel": "node scripts/check-build-config.mjs && vite build",
    "build:analyze": "ANALYZE=true vite build",
    "check:build-config": "node scripts/check-build-config.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "smoke": "node scripts/smoke-checks.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:supabase-production": "node scripts/verify-supabase-production.mjs",
    "migrate:build": "esbuild scripts/migrate-seed-data.mjs --bundle --platform=node --format=esm --packages=external --outfile=scripts/dist/migrate-seed.mjs",
    "migrate:seed": "npm run migrate:build && node scripts/dist/migrate-seed.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.3.1",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.1",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "fast-check": "^4.9.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.48.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.9"
  }
}
